@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            * {
                box-sizing: border-box;
            }

            html, body {
                margin: 0;
                padding: 0;
                width: 100%;
                min-height: 100%;
            }

            body {
                background: #f4f7fc;
                font-family: "Segoe UI", Arial, sans-serif;
                color: #172033;
            }
            
.login-container {
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

/* Reduce the complete login card */
.login-card {
    width: 100%;
    max-width: 750px;
    min-height: 0;
    margin:0 auto;
    background: #ffffff;
     box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
}

/* Keep both panels inside the smaller card */
.login-card .row {
    margin: 0;
}
@@media (max-width: 768px) {
    .login-card {
        max-width: 440px;
        padding: 16px;
    }
}    }
}

            
    </style>
</head>

<body>
    <main class="login-container">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
