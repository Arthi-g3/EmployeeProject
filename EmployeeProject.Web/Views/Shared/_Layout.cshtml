
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkforceHub</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeProject.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            body {
                background: #f4f6fa;
                margin: 0;
                font-family: Arial, sans-serif;
            }

            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                width: 245px;
                background: #17243b;
                color: #fff;
                padding: 24px 16px;
                overflow-y: auto;
                z-index: 1030;
            }

            .brand {
                font-size: 24px;
                font-weight: 700;
                color: #fff;
                text-decoration: none;
                display: block;
                padding: 8px 10px 30px;
            }

            .sidebar-label {
                color: #94a3b8;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1px;
                padding: 12px 12px 8px;
                text-transform: uppercase;
            }

            .sidebar .nav-link {
                color: #d5deeb;
                padding: 12px;
                margin-bottom: 5px;
                border-radius: 7px;
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
            }

                .sidebar .nav-link:hover {
                    color: #fff;
                    background: #2c405e;
                }

                .sidebar .nav-link i {
                    font-size: 18px;
                }

            .main-wrapper {
                margin-left: 245px;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .topbar {
                min-height: 72px;
                background: #fff;
                border-bottom: 1px solid #e5e7eb;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 12px 28px;
            }

            .page-title {
                margin: 0;
                color: #17243b;
                font-size: 21px;
                font-weight: 700;
            }

            .content-area {
                padding: 28px;
                flex: 1;
            }

            .profile-toggle {
                text-decoration: none;
                color: #263449;
                font-weight: 600;
            }

            .app-footer {
                padding: 16px 28px;
                color: #6b7280;
                background: #fff;
                border-top: 1px solid #e5e7eb;
            }

            @@media (max-width: 768px) {
                .sidebar {
                    width: 72px;
                    padding: 20px 8px;
                }

                .brand {
                    font-size: 0;
                    padding: 10px;
                }

                    .brand::before {
                        content: "WH";
                        font-size: 20px;
                    }

                .sidebar-label,
                .sidebar .nav-link span {
                    display: none;
                }

                .sidebar .nav-link {
                    justify-content: center;
                    padding: 13px 8px;
                }

                .main-wrapper {
                    margin-left: 72px;
                }

                .topbar {
                    padding: 12px 15px;
                }

                .content-area {
                    padding: 16px;
                }
            }
    </style>
</head>

<body>
    <aside class="sidebar">
        <a class="brand"
           asp-controller="Home"
           asp-action="Index">
            <i class="bi bi-building"></i> WorkforceHub
        </a>

        <div class="sidebar-label">Main Menu</div>

        <a class="nav-link"
           asp-controller="Home"
           asp-action="Index">
            <i class="bi bi-speedometer2"></i>
            <span>Home</span>
        </a>

        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
        {
            <a class="nav-link"
               asp-controller="Department"
               asp-action="Create">
                <i class="bi bi-building-add"></i>
                <span>Create Department</span>
            </a>

            <a class="nav-link"
               asp-controller="Employee"
               asp-action="Index">
                <i class="bi bi-people"></i>
                <span>Employee Management</span>
            </a>

            <a class="nav-link"
               asp-controller="Employee"
               asp-action="CreateEmployee">
                <i class="bi bi-person-plus"></i>
                <span>Register Employee</span>
            </a>

            <a class="nav-link"
               asp-controller="Designation"
               asp-action="Index">
                <i class="bi bi-briefcase"></i>
                <span>Designation Management</span>
            </a>

            
        }
        @if (User.IsInRole("Employee"))
        {
            <a class="nav-link"
               asp-controller="Leave"
               asp-action="ApplyLeave">
                <i class="bi bi-calendar-check"></i>
                <span>Apply Leave</span>
            </a>

            <a class="nav-link"
               asp-controller="Leave"
               asp-action="MyLeaves">
                <i class="bi bi-calendar2-week"></i>
                <span>My Leaves</span>
            </a>

            <a class="nav-link"
               asp-controller="Timesheet"
               asp-action="MyTimesheets">
                <i class="bi bi-clock-history"></i>
                <span>My Timesheets</span>
            </a>
        }
        @if (User.IsInRole("Manager"))
        {
            <a class="nav-link"
               asp-controller="Timesheet"
               asp-action="ManagerTimesheets">
                <i class="bi bi-clock-history"></i>
                <span>Employee Timesheets</span>
            </a>
        }
            @if (User.IsInRole("Admin") || User.IsInRole("HR"))
            {
            <a class="nav-link"
               asp-controller="Leave"
               asp-action="PendingLeaves">
                <i class="bi bi-calendar2-check"></i>
                <span>Pending Leaves</span>
            </a>
        }
        <li>
    <a asp-controller="Project"
       asp-action="Index">
        <i class="bi bi-folder"></i>
        Projects
    </a>
</li>
        <a class="nav-link"
           asp-controller="Home"
           asp-action="Privacy">
            <i class="bi bi-shield-check"></i>
            <span>Privacy</span>
        </a>
        <form asp-controller="Account"
              asp-action="Logout"
              method="post">
            @Html.AntiForgeryToken()

            <button type="submit" class="nav-link">
                <i class="bi bi-box-arrow-right"></i>
                <span>Logout</span>
            </button>
        </form>
    </aside>

    <div class="main-wrapper">
        <header class="topbar">
            <h1 class="page-title">@ViewData["Title"]</h1>

            <ul class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item dropdown">
                        <a class="profile-toggle dropdown-toggle"
                           href="#"
                           id="profileDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <i class="bi bi-person-circle"></i>
                            @User.Identity.Name
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end"
                            aria-labelledby="profileDropdown">
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Employee"
                                   asp-action="Profile">
                                    <i class="bi bi-person me-2"></i>
                                    My Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Password"
                                   asp-action="ChangePassword">
                                    <i class="bi bi-key me-2"></i> Change Password
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>

                            <li>
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="btn btn-primary btn-sm"
                           asp-controller="Account"
                           asp-action="Login">
                            Login
                        </a>
                    </li>
                }
            </ul>
        </header>

        <main role="main" class="content-area">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <small>
                &copy; @DateTime.Now.Year WorkforceHub.
                All rights reserved.
            </small>
        </footer>
    </div>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
