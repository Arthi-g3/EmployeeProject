
@model EmployeeProject.Core.ModelView.CreateEmployeeViewModel

@{
    ViewData["Title"] = "Create Employee";
}

<div class="employee-page">
    <div class="employee-card">

        <div class="employee-header">
            <h2>
                <i class="bi bi-person-plus me-2"></i>
                Register New Employee
            </h2>
            <p>Enter the employee details below to create a record.</p>
        </div>

        <form asp-controller="Employee"
              asp-action="CreateEmployee"
              method="post"
              class="employee-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <h5 class="form-section-title">
                <i class="bi bi-person-vcard me-2"></i>
                Employee Information
            </h5>

            <div class="row g-4">

                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter employee name" />
                    <span asp-validation-for="Name"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Age" class="form-label"></label>
                    <input asp-for="Age"
                           type="number"
                           class="form-control"
                           placeholder="Enter age" />
                    <span asp-validation-for="Age"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Gender" class="form-label"></label>
                    <select asp-for="Gender"
                            asp-items="Html.GetEnumSelectList<EmployeeProject.Model.Enums.Gender>()"
                            class="form-select">
                        <option value="">-- Select Gender --</option>
                    </select>
                    <span asp-validation-for="Gender"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="example@company.com" />
                    <span asp-validation-for="Email"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DepartmentId" class="form-label">
                        Department
                    </label>

                    <select asp-for="DepartmentId"
                            class="form-select"
                            asp-items="ViewBag.Departments"
                            id="DepartmentId">
                        <option value="">-- Select Department --</option>
                    </select>

                    <span asp-validation-for="DepartmentId"
                          class="text-danger small"></span>
                </div>

               
<div class="col-md-6">
    <label asp-for="DesignationId" class="form-label">
        Designation
    </label>

    <select asp-for="DesignationId"
            class="form-select"
            id="DesignationId"
            disabled>
        <option value="">-- Select Department First --</option>
    </select>

    <span asp-validation-for="DesignationId"
          class="text-danger small"></span>
</div>


                <div class="col-md-6">
                    <label asp-for="ReportingPersonId" class="form-label">
                        Reporting Person
                    </label>

                    <select asp-for="ReportingPersonId"
                            asp-items="ViewBag.ReportingPersons"
                            class="form-select">
                        <option value="">-- Select Reporting Person --</option>
                    </select>

                    <span asp-validation-for="ReportingPersonId"
                          class="text-danger small"></span>
                </div>


                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber"
                           type="tel"
                           class="form-control"
                           placeholder="Enter phone number" />
                    <span asp-validation-for="PhoneNumber"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City"
                           class="form-control"
                           placeholder="Enter city" />
                    <span asp-validation-for="City"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Salary" class="form-label"></label>
                    <input asp-for="Salary"
                           type="number"
                           min="0.01"
                           step="0.01"
                           class="form-control"
                           placeholder="Enter salary" />
                    <span asp-validation-for="Salary"
                          class="text-danger small"></span>
                </div>

            </div>

            <div class="employee-actions">
                <a asp-controller="Employee"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-person-check me-1"></i>
                    Create Employee
                </button>
            </div>

        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const allDesignations =
                        @Html.Raw(ViewBag.DesignationData ?? "[]");

            const departmentDropdown =
                document.getElementById("DepartmentId");

            const designationDropdown =
                document.getElementById("DesignationId");

            const selectedDesignationId =
                "@(Model?.DesignationId ?? 0)";

            function loadDesignations() {

                const departmentId = departmentDropdown.value;

                designationDropdown.innerHTML =
                    '<option value="">-- Select Designation --</option>';

                if (!departmentId) {
                    designationDropdown.disabled = true;
                    return;
                }

                const filteredDesignations = allDesignations.filter(
                    d => String(d.departmentId) === String(departmentId)
                );

                filteredDesignations.forEach(function(designation) {

                    const option = document.createElement("option");

                    option.value = designation.id;
                    option.textContent = designation.name;

                    if (String(designation.id) === selectedDesignationId) {
                        option.selected = true;
                    }

                    designationDropdown.appendChild(option);
                });

                designationDropdown.disabled =
                    filteredDesignations.length === 0;
            }

            departmentDropdown.addEventListener("change", loadDesignations);

            loadDesignations();
        });
    </script>
}

