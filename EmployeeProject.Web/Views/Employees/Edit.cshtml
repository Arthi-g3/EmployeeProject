@model EmployeeProject.Core.ModelView.EditEmployeeViewModel

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container mt-4">
    <h2>Edit Employee</h2>

    <form asp-controller="Employee" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input asp-for="EmpId" type="hidden" />
        <input asp-for="CreatedDate" type="hidden" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Age" class="form-label"></label>
            <input asp-for="Age" class="form-control" />
            <span asp-validation-for="Age" class="text-danger"></span>
        </div>

       
        <div class="mb-3">
            <label asp-for="Gender" class="form-label"></label>
            <select asp-for="Gender"
                    asp-items="Html.GetEnumSelectList<EmployeeProject.Model.Enums.Gender>()"
                    class="form-select">
                <option value="">-- Select Gender --</option>
            </select>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        
        <div class="col-md-3">
            <label asp-for="DepartmentId" class="form-label">Department</label>
            <select asp-for="DepartmentId"
                    class="form-select"
                    asp-items="ViewBag.Departments">
                <option value="">-- Select Department --</option>
            </select>
            <span asp-validation-for="DepartmentId"
                  class="text-danger small"></span>
        </div>


        <div class="mb-3">
            <label asp-for="DesignationId" class="form-label">
                Designation
            </label>

            <select asp-for="DesignationId"
                    asp-items="@(ViewBag.Designations)"
                    class="form-select">
                <option value="">-- Select Designation --</option>
            </select>

            <span asp-validation-for="DesignationId"
                  class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ReportingPersonId" class="form-label">
                Reporting Person
            </label>

            <select asp-for="ReportingPersonId"
                    asp-items="ViewBag.ReportingPersons"
                    class="form-select">
                <option value="">-- Select Reporting Person --</option>
            </select>

            <span asp-validation-for="ReportingPersonId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Salary" class="form-label"></label>
            <input asp-for="Salary" type="number" step="0.01" min="0"
                   class="form-control" />
            <span asp-validation-for="Salary" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Created Date</label>
            <input value="@Model.CreatedDate.ToString("dd-MM-yyyy HH:mm")"
                   class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Updated Date</label>
            <input value="@(Model.UpdatedDate?.ToString("dd-MM-yyyy HH:mm")
                                           ?? "Not updated yet")"
                   class="form-control" readonly />
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>

        <a asp-controller="Employee"
           asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
