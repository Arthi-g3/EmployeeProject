

@{
    ViewData["Title"] = "Dashboard";

    bool isAdmin = User.IsInRole("Admin");
    bool isHR = User.IsInRole("HR");
    bool isManager = User.IsInRole("Manager");
    bool isEmployee = User.IsInRole("Employee");

    string roleName = isAdmin ? "Administrator"
                    : isHR ? "Human Resources"
                    : isManager ? "Manager"
                    : isEmployee ? "Employee"
                    : "User";

    string themeColor = isAdmin ? "#2563eb"
                      : isHR ? "#059669"
                      : isManager ? "#7c3aed"
                      : "#0891b2";
}


<style>
    .dashboard-container {
        max-width: 1400px;
        margin: auto;
    }

    .welcome-card {
        background: linear-gradient(120deg, #17243b, #334f75);
        color: white;
        border: none;
        border-radius: 16px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, .10);
    }

    .welcome-card h2 {
        font-size: 27px;
        font-weight: 700;
    }

    .welcome-card p {
        color: #dbeafe;
        margin-bottom: 0;
    }

    .role-label {
        display: inline-block;
        padding: 7px 14px;
        margin-top: 15px;
        border-radius: 20px;
        background: rgba(255,255,255,.15);
        color: white;
        font-size: 13px;
    }

    .section-heading {
        font-size: 19px;
        font-weight: 700;
        color: #17243b;
        margin-bottom: 18px;
    }

    .dashboard-card {
        height: 100%;
        min-height: 225px;
        padding: 23px;
        background: white;
        border: 1px solid #e8edf4;
        border-radius: 13px;
        box-shadow: 0 3px 12px rgba(15,23,42,.04);
        transition: transform .2s, box-shadow .2s;
    }

    .dashboard-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 9px 22px rgba(15,23,42,.10);
    }

    .dashboard-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        border-radius: 12px;
        font-size: 23px;
        margin-bottom: 18px;
    }

    .dashboard-card h5 {
        color: #17243b;
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .dashboard-card p {
        color: #64748b;
        font-size: 14px;
        min-height: 42px;
        line-height: 1.6;
    }

    .dashboard-btn {
        border-radius: 7px;
        font-size: 13px;
        font-weight: 600;
        padding: 9px 15px;
    }

    .admin-icon {
        background: #eff6ff;
        color: #2563eb;
    }

    .hr-icon {
        background: #ecfdf5;
        color: #059669;
    }

    .employee-icon {
        background: #ecfeff;
        color: #0891b2;
    }

    @@media(max-width: 768px) {
        .welcome-card {
            padding: 22px;
        }

        .welcome-card h2 {
            font-size: 22px;
        }

        .dashboard-card {
            min-height: 210px;
        }
    }
</style>

<div class="container-fluid dashboard-container">

    <!-- Welcome Section -->
    <div class="welcome-card">
        <h2>Welcome to WorkforceHub!</h2>

        <p>
            Your Workforce, Connected.
            Manage your work efficiently from one place.
        </p>

        <span class="role-label">
            <i class="bi bi-person-badge me-1"></i>
            @roleName
        </span>
    </div>

    <!-- ADMIN DASHBOARD -->
    @if (isAdmin)
    {
        <h4 class="section-heading">
            <i class="bi bi-speedometer2 me-2"></i>
            Administration
        </h4>

        <div class="row g-4 mb-4">

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon admin-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <h5>Employee Management</h5>
                    <p>Register employees and manage employee records.</p>

                    <a asp-controller="Employee"
                       asp-action="Index"
                       class="btn btn-primary dashboard-btn">
                        View Employees
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon admin-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>

                    <h5>Register Employee</h5>
                    <p>Create new employee accounts and maintain records.</p>

                    <a asp-controller="Employee"
                       asp-action="CreateEmployee"
                       class="btn btn-primary dashboard-btn">
                        Register Employee
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon admin-icon">
                        <i class="bi bi-building"></i>
                    </div>

                    <h5>Department Management</h5>
                    <p>Create and manage organizational departments.</p>

                    <a asp-controller="Department"
                       asp-action="Index"
                       class="btn btn-primary dashboard-btn">
                        Manage Departments
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon admin-icon">
                        <i class="bi bi-calendar2-check"></i>
                    </div>

                    <h5>Leave Management</h5>
                    <p>Review employee leave requests and take action.</p>

                    <a asp-controller="Leave"
                       asp-action="PendingLeaves"
                       class="btn btn-primary dashboard-btn">
                        Review Leaves
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon admin-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>

                    <h5>Designation Management</h5>
                    <p>Manage employee designations.</p>

                    <a asp-controller="Designation"
                       asp-action="Index"
                       class="btn btn-primary dashboard-btn">
                        Manage Designations
                    </a>
                </div>
            </div>

        </div>
    }

    <!-- HR DASHBOARD -->
    @if (isHR)
    {
        <h4 class="section-heading">
            <i class="bi bi-people me-2"></i>
            Human Resources
        </h4>

        <div class="row g-4 mb-4">

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon hr-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>

                    <h5>Register Employee</h5>
                    <p>Register new employees and maintain their information.</p>

                    <a asp-controller="Employee"
                       asp-action="CreateEmployee"
                       class="btn btn-success dashboard-btn">
                        Register Employee
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon hr-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <h5>Employee Management</h5>
                    <p>View and manage employee information.</p>

                    <a asp-controller="Employee"
                       asp-action="Index"
                       class="btn btn-success dashboard-btn">
                        View Employees
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon hr-icon">
                        <i class="bi bi-building"></i>
                    </div>

                    <h5>Department Information</h5>
                    <p>View organizational department details.</p>

                    <a asp-controller="Department"
                       asp-action="Index"
                       class="btn btn-success dashboard-btn">
                        View Departments
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon hr-icon">
                        <i class="bi bi-calendar2-check"></i>
                    </div>

                    <h5>Leave Management</h5>
                    <p>Review and process assigned employee leave requests.</p>

                    <a asp-controller="Leave"
                       asp-action="PendingLeaves"
                       class="btn btn-success dashboard-btn">
                        Review Leaves
                    </a>
                </div>
            </div>

        </div>
    }

    
    <!-- MANAGER DASHBOARD -->
    @if (isManager)
    {
        <h4 class="section-heading">
            <i class="bi bi-person-workspace me-2"></i>
            Manager Workspace
        </h4>

        <div class="row g-4 mb-4">

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon"
                         style="background:#f3e8ff; color:#7c3aed;">
                        <i class="bi bi-kanban"></i>
                    </div>

                    <h5>Project Management</h5>
                    <p>View and manage assigned projects.</p>

                    <a asp-controller="Project"
                       asp-action="Index"
                       class="btn btn-primary dashboard-btn">
                        View Projects
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon"
                         style="background:#f3e8ff; color:#7c3aed;">
                        <i class="bi bi-list-task"></i>
                    </div>

                    <h5>Assign Tasks</h5>
                    <p>Assign tasks to employees under your projects.</p>

                    <a asp-controller="ManagerTask"
                       asp-action="Assign"
                       class="btn btn-primary dashboard-btn">
                        Assign Tasks
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon"
                         style="background:#f3e8ff; color:#7c3aed;">
                        <i class="bi bi-clipboard-check"></i>
                    </div>

                    <h5>Track Tasks</h5>
                    <p>Monitor employee task status and progress.</p>

                    <a asp-controller="ManagerTask"
                       asp-action="Index"
                       class="btn btn-primary dashboard-btn">
                        Track Tasks
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon"
                         style="background:#f3e8ff; color:#7c3aed;">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <h5>Employee Timesheets</h5>
                    <p>View submitted timesheets from employees.</p>

                    <a asp-controller="Timesheet"
                       asp-action="ManagerTimesheets"
                       class="btn btn-primary dashboard-btn">
                        View Timesheets
                    </a>
                </div>
            </div>

        </div>
    }

    <!-- EMPLOYEE DASHBOARD -->
    @if (isEmployee)
    {
        <h4 class="section-heading">
            <i class="bi bi-person-workspace me-2"></i>
            My Workspace
        </h4>

        <div class="row g-4 mb-4">

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon employee-icon">
                        <i class="bi bi-person-circle"></i>
                    </div>

                    <h5>My Profile</h5>
                    <p>View your employee details and profile information.</p>

                    <a asp-controller="Employee"
                       asp-action="Profile"
                       class="btn btn-info text-white dashboard-btn">
                        View My Profile
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon employee-icon">
                        <i class="bi bi-list-task"></i>
                    </div>

                    <h5>My Tasks</h5>
                    <p>View your assigned tasks and their current status.</p>

                    <a asp-controller="Task"
                       asp-action="Index"
                       class="btn btn-info text-white dashboard-btn">
                        View My Tasks
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon employee-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <h5>My Timesheets</h5>
                    <p>Submit and review your daily work hours.</p>

                    <a asp-controller="Timesheet"
                       asp-action="MyTimesheets"
                       class="btn btn-info text-white dashboard-btn">
                        View My Timesheets
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon employee-icon">
                        <i class="bi bi-calendar-plus"></i>
                    </div>

                    <h5>Apply Leave</h5>
                    <p>Submit a new leave request.</p>

                    <a asp-controller="Leave"
                       asp-action="ApplyLeave"
                       class="btn btn-info text-white dashboard-btn">
                        Apply Leave
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon employee-icon">
                        <i class="bi bi-calendar2-week"></i>
                    </div>

                    <h5>My Leaves</h5>
                    <p>Check your leave history and approval status.</p>

                    <a asp-controller="Leave"
                       asp-action="MyLeaves"
                       class="btn btn-info text-white dashboard-btn">
                        View My Leaves
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="dashboard-icon employee-icon">
                        <i class="bi bi-key"></i>
                    </div>

                    <h5>Change Password</h5>
                    <p>Update your account password securely.</p>

                    <a asp-controller="Password"
                       asp-action="ChangePassword"
                       class="btn btn-info text-white dashboard-btn">
                        Change Password
                    </a>
                </div>
            </div>

        </div>
    }

    @if (!isAdmin && !isHR && !isManager && !isEmployee)
    {
        <div class="alert alert-warning">
            Your account does not have a recognized dashboard role.
            Please contact your administrator.
        </div>
    }

</div>
