@model EmployeeProject.Model.Department

<h2>Create Department</h2>

<form asp-controller="Department"
      asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="DepartmentName" class="form-label">
            Department Name
        </label>

        <input asp-for="DepartmentName" class="form-control" />

        <span asp-validation-for="DepartmentName"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create Department
    </button>
    <a asp-controller="Department"
       asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]))
                        });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]))
                        });
        </script>
    }
}
