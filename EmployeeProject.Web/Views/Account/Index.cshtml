@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2>Admin Dashboard</h2>
        </div>

        <div class="card-body">
            <h3>Welcome, Admin!</h3>

            <p>
                Welcome to the Employee Management System.
                You have successfully logged in as an Administrator.
            </p>

            <hr />

            <h4>Admin Details</h4>

            <p><strong>Role:</strong> Administrator</p>
            <p><strong>Access Level:</strong> Full System Access</p>

            <hr />

            <h4>Admin Responsibilities</h4>

            <ul>
                <li>Manage employee details.</li>
                <li>Create and manage user accounts.</li>
                <li>Assign roles and permissions.</li>
                <li>View and maintain employee records.</li>
                <li>Monitor HR and employee activities.</li>
            </ul>

            <div class="alert alert-info mt-3">
                Use this dashboard to manage employees,
                user accounts, and system permissions.
            </div>
        </div>
    </div>
</div>
