```razor
@model EmployeeProject.Core.ModelView.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container mt-5" style="max-width: 450px;">
    <h2>Reset Password</h2>

    <p class="text-muted">
        Enter your new password below.
    </p>

    <form asp-controller="Password"
          asp-action="ResetPassword"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">
                New Password
            </label>

            <input asp-for="NewPassword"
                   type="password"
                   class="form-control"
                   placeholder="Enter new password" />

            <span asp-validation-for="NewPassword"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">
                Confirm Password
            </label>

            <input asp-for="ConfirmPassword"
                   type="password"
                   class="form-control"
                   placeholder="Confirm new password" />

            <span asp-validation-for="ConfirmPassword"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">
            Reset Password
        </button>

        <div class="text-center mt-3">
            <a asp-controller="Account" asp-action="Login">
                Back to Login
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
```
