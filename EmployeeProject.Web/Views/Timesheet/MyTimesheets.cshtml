@model List<EmployeeProject.Model.Timesheet>

@{
    ViewData["Title"] = "My Timesheets";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My Timesheets</h2>
        <a asp-action="Create" class="btn btn-primary">Submit Timesheet</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Work Date</th>
                        <th>Project</th>
                        <th>Hours</th>
                        <th>Task Reference</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Submitted Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var timesheet in Model)
                    {
                        <tr>
                            <td>@timesheet.WorkDate.ToString("dd-MM-yyyy")</td>
                            <td>@timesheet.Project?.ProjectName</td>
                            <td>@timesheet.Hours</td>
                            <td>@timesheet.TaskReference</td>
                            <td>@timesheet.Description</td>
                            <td>@timesheet.Status</td>
                            <td>@timesheet.SubmittedDate.ToString("dd-MM-yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p>No timesheets submitted yet.</p>
    }

    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
        Back to Dashboard
    </a>
</div>
